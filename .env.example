# Supabase — obtener de https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor (nunca exponer al cliente): usada por API Routes para bypass de RLS
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (para armar los QRs). En dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
